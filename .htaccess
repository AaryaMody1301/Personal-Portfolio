# Five real static pages, served without an application router.
DirectoryIndex index.html
AddType font/woff2 .woff2
AddType image/png .png
AddType image/vnd.microsoft.icon .ico

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.aaryamody\.app$ [NC]
  RewriteRule ^ https://aaryamody.app%{REQUEST_URI} [R=301,L]
  RewriteRule ^projects/(driftdoctor|stockpulse|sales-forecasting)\.html$ /projects/$1/ [R=301,L]
  RewriteRule ^projects/sql-analytics\.html$ /#work-sql-practice-project [R=301,L,NE]
  RewriteRule ^projects/sql-practice/$ /#work-sql-practice-project [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|png|ico|webp|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=604800, no-transform"
  </FilesMatch>
  <FilesMatch "^(index\.html|manifest\.json|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compress text/font transfers; CDN Brotli may supersede this at the edge.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
