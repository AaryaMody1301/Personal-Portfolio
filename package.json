{
  "name": "aarya-mody-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Aarya Mody's static data analytics and engineering portfolio, with an optional interactive world.",
  "license": "MIT",
  "author": "Aarya Mody",
  "homepage": "https://aaryamody.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaryaMody1301/Personal-Portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/AaryaMody1301/Personal-Portfolio/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:environment": "node scripts/prepare-environment.mjs",
    "assets:check": "node scripts/prepare-assets.mjs --check",
    "preserve": "npm run build",
    "serve": "node scripts/static-server.cjs",
    "pretest": "node scripts/prepare-assets.mjs --check",
    "test": "playwright test",
    "pretest:ci": "node scripts/prepare-assets.mjs --check",
    "test:ci": "playwright test --grep-invert \"visual baseline\"",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "pretest:update": "node scripts/prepare-assets.mjs --check",
    "test:update": "playwright test --update-snapshots",
    "preaudit": "node scripts/prepare-assets.mjs --check",
    "audit": "node scripts/audit.mjs",
    "audit:preview": "node scripts/prepare-assets.mjs --check && node scripts/audit-preview.mjs",
    "package:hostinger": "pwsh -NoProfile -File scripts/package-hostinger.ps1",
    "preview:capture": "node scripts/capture-world.mjs",
    "compatibility:capture": "node scripts/capture-world-compatibility.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "build": "node scripts/build.mjs && node scripts/prepare-assets.mjs",
    "profile:world": "node scripts/profile-world.mjs",
    "profile:startup": "node scripts/profile-startup.mjs",
    "links:check": "node scripts/check-links.mjs",
    "navigation:check": "node scripts/check-navigation.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.2",
    "lighthouse": "13.5.0",
    "sharp": "0.35.4"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lucide": "1.48.0",
    "three": "0.186.1"
  }
}
